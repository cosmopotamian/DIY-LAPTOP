(kicad_pcb
	(version 20241229)
	(generator "pcbnew")
	(generator_version "9.0")
	(general
		(thickness 1.2)
		(legacy_teardrops no)
	)
	(paper "A4")
	(layers
		(0 "F.Cu" mixed)
		(4 "In1.Cu" power)
		(6 "In2.Cu" signal)
		(8 "In3.Cu" signal)
		(10 "In4.Cu" power)
		(2 "B.Cu" mixed)
		(9 "F.Adhes" user)
		(11 "B.Adhes" user)
		(13 "F.Paste" user)
		(15 "B.Paste" user)
		(5 "F.SilkS" user)
		(7 "B.SilkS" user)
		(1 "F.Mask" user)
		(3 "B.Mask" user)
		(17 "Dwgs.User" user)
